---
import Layout from "../components/Layout.astro";
import LightningDonate from "../components/LightningDonate.astro";

const helpItems = [
  {
    icon: "code",
    title: "Code",
    description:
      "Contribute PRs to our open-source tools, Nostr client interfaces, and data visualization repos.",
    linkLabel: "View GitHub",
    linkUrl: "#",
  },
  {
    icon: "menu_book",
    title: "Research",
    description:
      "Submit whitepapers, protocol analysis, or cryptographic reviews to our peer-reviewed archive.",
    linkLabel: "Read papers",
    linkUrl: "#",
  },
  {
    icon: "lan",
    title: "Infrastructure",
    description:
      "Run a Nostr relay or a Bitcoin full node, provide liquidity, or assist in maintaining our physical node architecture.",
    linkLabel: "Setup guide",
    linkUrl: "#",
  },
];
---

<Layout title="Contribute" active="contribute">
  <section class="page-hero">
    <h1 class="page-title">Contribute to the Network</h1>
    <p class="page-lead">
      &gt; Initializing contribution protocol...<br />
      &gt; Sovereign research requires uncompromised funding and
      collaborative rigor. Support the pursuit of hard money and
      open-source infrastructure.
    </p>
  </section>

  <section class="contribute-grid">
    <LightningDonate />
  </section>

  <section class="help-section">
    <h2 class="section-title small">Other vectors of contribution</h2>
    <div class="grid-3">
      {helpItems.map((item) => (
        <div class="help-card">
          <span class="material-symbols-outlined help-icon" aria-hidden="true">{item.icon}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <a href={item.linkUrl}>&gt; {item.linkLabel}</a>
        </div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    text-align: center;
  }
  .page-lead {
    color: var(--muted);
    max-width: 62ch;
    border-left: 2px solid var(--accent);
    padding: 1rem 1.25rem;
    background: var(--bg-alt);
    text-align: left;
    margin: 0 auto;
  }
  .contribute-grid {
    margin-bottom: 3rem;
  }
  .help-section {
    margin-bottom: 3rem;
  }
  .help-card {
    position: relative;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--muted-2);
    background: var(--bg-raised);
  }
  .help-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--fg);
    transition: background-color 0.15s;
  }
  .help-card:hover {
    background: var(--bg-alt);
  }
  .help-card:hover::before {
    background: var(--accent);
  }
  .help-icon {
    font-size: 30px;
    color: var(--fg);
    margin-bottom: 0.75rem;
    transition: color 0.15s;
  }
  .help-card:hover .help-icon {
    color: var(--accent);
  }
  .help-card h3 {
    text-transform: uppercase;
    margin: 0 0 0.75rem 0;
  }
  .help-card p {
    flex: 1;
    margin: 0 0 1rem 0;
    color: var(--muted);
  }
  .help-card a {
    color: var(--fg);
    text-decoration: none;
    font-size: 0.85rem;
    text-transform: uppercase;
  }
  .help-card a:hover {
    color: var(--accent);
  }
</style>
