---
import Layout from "../components/Layout.astro";
import HeroProfileCard from "../components/HeroProfileCard.astro";
import NetworkTerminal from "../components/NetworkTerminal.astro";
import NoteCard from "../components/NoteCard.astro";
import JoinBlock from "../components/JoinBlock.astro";
import { RELAYS } from "../../scripts/lib/relays.mjs";
import { nip19 } from "nostr-tools";
import profile from "../data/profile.json";
import feed from "../data/feed.json";
import projects from "../data/projects.json";
import calendar from "../data/calendar.json";
import relayData from "../data/relays.json";
import members from "../data/members.json";

const displayName = profile.display_name || profile.name || "Clube Bitcoin UFMG";
const about =
  profile.about ||
  "Academic rigor meets cypherpunk ethos. We are a sovereign collective dedicated to the research, development, and proliferation of Bitcoin and decentralized protocols. Proof-of-work in code and in thought.";

const projectsCount = projects.projects.length;
const eventsCount = calendar.upcoming.length + calendar.past.length;
const recentItems = (feed.items ?? []).slice(0, 8);
const profilePicture = profile.picture ?? null;

// pubkey → display name map so note cards show a human-readable author
// (club profile first, then the member roster) instead of raw pubkeys.
const authorNames: Record<string, string> = {};
if (profile.pubkey) {
  authorNames[profile.pubkey] =
    profile.display_name || profile.name || "Clube Bitcoin UFMG";
}
for (const member of members.members ?? []) {
  if (member.pubkey && member.name) authorNames[member.pubkey] = member.name;
}

let clubNpub: string | null = null;
try {
  clubNpub = nip19.npubEncode(profile.pubkey);
} catch {
  clubNpub = null;
}
---

<Layout title="Home">
  <HeroProfileCard
    displayName={displayName}
    about={about}
    pubkey={profile.pubkey}
    projectsCount={projectsCount}
    eventsCount={eventsCount}
  />

  <section class="activity-section">
    <div class="activity-intro">
      <NetworkTerminal
        probes={relayData.relays ?? []}
        fallbackRelays={RELAYS}
        feedItems={recentItems}
        calendar={calendar}
        sync={{
          relays: relayData.probedAt ?? null,
          feed: feed.fetchedAt ?? null,
          calendar: calendar.fetchedAt ?? null,
        }}
        whoami={{ npub: clubNpub, lud16: profile.lud16 ?? null }}
      />
    </div>

    <div class="activity-feed">
      <div class="feed-head">
        <div class="feed-head-text">
          <h2 class="section-title small">[ Recent Activity ]</h2>
          <p class="feed-desc">A live dispatch from our connected relays — research updates, milestones, and cypherpunk musings.</p>
        </div>
        
      </div>
  
      <div>
        <p class="feed-kicker">:: SYS.DIR.QUERY( LAST_POSTS )</p>
      </div>
      <div class="feed-scroll">
        {recentItems.length > 0 ? (
          recentItems.map((item) => (
            <NoteCard item={item} avatarUrl={profilePicture} authorNames={authorNames} />
          ))
        ) : (
          <p class="empty">No posts fetched yet.</p>
        )}
      </div>
      <div class="feed-fade" aria-hidden="true"></div>
    </div>
  </section>

  <JoinBlock />
</Layout>

<style>
  .activity-section {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    margin: 2.5rem 0;
    padding-top: 2.5rem;
    height: 560px;
  }
  @media (max-width: 768px) {
    .activity-section {
      grid-template-columns: 1fr;
      height: auto;
    }
  }

  /* Both columns stretch to the same height, so the terminal panel and
     the feed panel always end on the same line — no ragged edge. */
  .activity-intro,
  .activity-feed {
    height: 100%;
    min-height: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .activity-intro > :global(.terminal) {
    flex: 1 1 0;
    min-height: 0;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .activity-intro,
    .activity-feed {
      height: 420px;
    }
  }

  .activity-feed {
    position: relative;
    border-radius: 12px;
    border: 1px solid rgba(26, 26, 26, 0.12);
    overflow: hidden;
    backdrop-filter: blur(1px) saturate(100%);
    box-shadow:
      0 24px 48px -16px rgba(26, 26, 26, 0.22),
      0 12px 28px -12px rgba(26, 26, 26, 0.16),
      0 2px 8px rgba(26, 26, 26, 0.08);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .activity-feed {
      background: var(--bg-soft-fallback);
    }
  }
  .feed-kicker {
    margin: 0;
    padding: 0.75rem 1.25rem 0.5rem 1.25rem;
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: 0.85;
  }
  .feed-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--bg-soft);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(4px) saturate(250%);
    border-bottom: 1px solid rgba(26, 26, 26, 0.12);
    flex-shrink: 0;
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .feed-head {
      background: var(--bg-soft-fallback);
    }
  }
  .feed-head-text {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--muted)
  }
  .feed-head .section-title.small {
    border-bottom: none;
    padding-bottom: 0;
    margin: 0;
    font-size: 1.5rem;
  }
  .feed-desc {
    margin: 0;
    font-size: 0.78rem;
    color: var(--muted);
    max-width: 52ch;
  }
  .feed-tag {
    font-size: 0.68rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .feed-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    scroll-snap-type: y proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
  }
  .feed-scroll::-webkit-scrollbar {
    width: 8px;
  }
  .feed-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .feed-scroll::-webkit-scrollbar-thumb {
    background: var(--accent);
  }
  .feed-scroll :global(.note-card) {
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  /* Subtle fade at the bottom edge to hint there's more to scroll.
     Fades into the soft page background instead of black. */
  .feed-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 40px;
    background: linear-gradient(
      to bottom,
      rgba(240, 238, 231, 0),
      rgba(240, 238, 231, 0.92)
    );
    pointer-events: none;
  }

</style>