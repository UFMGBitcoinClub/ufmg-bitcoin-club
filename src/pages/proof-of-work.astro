---
import Layout from "../components/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Carousel from "../components/Carousel.astro";
import data from "../data/projects.json";

const PROJECT_TYPES = ["repo", "pr", "paper"];

const typeCounts = PROJECT_TYPES.map((key) => ({
  key,
  count: data.projects.filter((p) => p.type.toLowerCase() === key).length,
}));
---

<Layout title="Proof of Work" active="pow">
  <section class="page-hero panel--accent-left">
    <h1 class="page-title">Proof of Work</h1>
    <p class="page-lead">
      An immutable directory of ongoing research, Proof of Concepts, PR and all other work conducted by Club participants.
    </p>
  </section>
  
  {data.projects.length > 0 ? (
    <section class="projects-section">
      <div class="filter-bar" role="tablist" aria-label="Filter projects by type">
        <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
          [[ ALL PROJECTS ]] <span class="filter-count">{data.projects.length}</span>
        </button>
        {typeCounts.map(({ key, count }) => (
          <button class="filter-btn" data-filter={key} role="tab" aria-selected="false">
            [ {key.toUpperCase()} ] <span class="filter-count">{count}</span>
          </button>
        ))}
      </div>

      <p style="color: var(--accent)"class="page-kicker">:: SYS.DIR.QUERY( PROJECTS )</p>

      <Carousel ariaLabel="projects">
        {data.projects.map((project) => <ProjectCard project={project} />)}
      </Carousel>

      <p class="empty" data-projects-empty hidden>No projects match this filter.</p>
    </section>
  ) : (
    <p class="empty">
      No projects published yet.
    </p>
  )}
</Layout>

<style>
  /* Floating glass panel matching the home feed section. */
  .projects-section {
    --carousel-fade: rgba(240, 238, 231, 0.9);
    margin-bottom: 3rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border-radius: 12px;
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(2px) saturate(100%);
    border: 1px solid rgba(26, 26, 26, 0.12);
    box-shadow:
      0 24px 48px -16px rgba(26, 26, 26, 0.22),
      0 12px 28px -12px rgba(26, 26, 26, 0.16),
      0 2px 8px rgba(26, 26, 26, 0.08);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .projects-section {
      background: var(--bg-soft-fallback);
    }
  }
  @media (max-width: 480px) {
    .projects-section {
      padding: 0.9rem 0.9rem 1.1rem;
    }
    .filter-bar {
      gap: 0.9rem;
    }
  }
  .page-lead {
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
  }
  .filter-bar {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    overflow-x: auto;
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(26, 26, 26, 0.12);
  }
  .filter-btn {
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: none;
    border: none;
    padding: 0;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
  }
  .filter-btn:hover {
    color: var(--fg);
  }
  .filter-btn.is-active {
    color: var(--accent);
  }
  .filter-count {
    opacity: 0.7;
    margin-left: 0.3rem;
  }
  .projects-section :global(.project-card[hidden]) {
    display: none;
  }
</style>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    ".filter-bar .filter-btn"
  );
  const cards = document.querySelectorAll<HTMLElement>("[data-project-type]");
  const emptyMessage = document.querySelector<HTMLElement>("[data-projects-empty]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter ?? "all";

      filterButtons.forEach((b) => {
        b.classList.toggle("is-active", b === button);
        b.setAttribute("aria-selected", String(b === button));
      });

      let visible = 0;
      cards.forEach((card) => {
        const matches = filter === "all" || card.dataset.projectType === filter;
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      if (emptyMessage) emptyMessage.hidden = visible > 0;
    });
  });
</script>
