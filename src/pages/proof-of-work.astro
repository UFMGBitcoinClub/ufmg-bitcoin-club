---
import Layout from "../components/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { PROJECTS } from "../config/projects.mjs";
---

<Layout title="Proof of Work" active="pow">
  <section class="page-hero panel--muted">
    <h1 class="page-title">Proof of Work.</h1>
    <p>
      An open ledger of active research modules, protocol analyses, and engineering
      projects developed by the collective. Strict adherence to verifiable computation
      and peer review.
    </p>
  </section>

  <section class="grid-3">
    {PROJECTS.map((project) => <ProjectCard project={project} />)}
  </section>
</Layout>

<style>
  .grid-3 {
    margin-bottom: 3rem;
  }
</style>
