---
import Layout from "../components/Layout.astro";
import EventCard from "../components/EventCard.astro";
import calendar from "../data/calendar.json";
import rsvpsData from "../data/rsvps.json";
import { RELAYS } from "../../scripts/lib/relays.mjs";
import { CLUB_PUBKEY } from "../config/club.mjs";

const allEvents = [...calendar.upcoming, ...calendar.past];
const hasEvents = allEvents.length > 0;

const EVENT_CATEGORIES = [
  { key: "seminars", stem: "seminar" },
  { key: "workshops", stem: "workshop" },
  { key: "bitdevs", stem: "bitdev" },
];

const categoryCounts = EVENT_CATEGORIES.map(({ key, stem }) => ({
  key,
  count: allEvents.filter((ev) =>
    (ev.tags ?? []).some((t) => t.toLowerCase().startsWith(stem))
  ).length,
}));

// RSVP counts from rsvps.json, keyed by calendar event id (the aggregator
// also keys by NIP-52 address, but id lookups cover both `e` and `a` refs).
const byEvent = (rsvpsData.byEvent ?? {}) as Record<
  string,
  { going: number; tentative: number; declined: number }
>;
function rsvpFor(event: { id: string }) {
  return byEvent[event.id];
}
---

<Layout title="Events" active="events">
  <section class="page-hero panel--accent-left">
    <h1 class="page-title">Events &amp; Symposia</h1>
    <p class="page-lead">
      Our calendar of seminars, workshops, and meetings 
    </p>
  </section>

  {hasEvents ? (
    <section class="events-panel">
      <div class="filter-bar" role="tablist" aria-label="Filter events by category">
        <button class="filter-btn is-active" data-filter="all" role="tab" aria-selected="true">
          [[ ALL EVENTS ]] <span class="filter-count">{allEvents.length}</span>
        </button>
        {categoryCounts.map(({ key, count }) => (
          <button class="filter-btn" data-filter={key} role="tab" aria-selected="false">
            [ {key.toUpperCase()} ] <span class="filter-count">{count}</span>
          </button>
        ))}
      </div>

      <p style="color: var(--accent)"class="page-kicker">:: SYS.DIR.QUERY( EVENTS )</p>

      <div class="events-wrap">
        <div
          class="events-list"
          data-events-grid
          data-club-pubkey={CLUB_PUBKEY}
          data-relays={JSON.stringify(RELAYS)}
        >
          {calendar.upcoming.length > 0 && (
            <section class="events-group" data-group="upcoming">
              <h2 class="events-group-label events-group-label--upcoming">[ Upcoming ]</h2>
              {calendar.upcoming.map((event) => (
                <EventCard event={event} status="upcoming" rsvp={rsvpFor(event)} />
              ))}
            </section>
          )}
          {calendar.past.length > 0 && (
            <section class="events-group" data-group="past">
              <h2 class="events-group-label events-group-label--past">[ Past ]</h2>
              {calendar.past.map((event) => (
                <EventCard event={event} status="past" rsvp={rsvpFor(event)} />
              ))}
            </section>
          )}
          <p class="empty" data-events-empty hidden>No events in this category yet.</p>
        </div>
        <div class="events-fade" aria-hidden="true"></div>
      </div>
    </section>
  ) : (
    <p class="empty">
      No events published yet — once the manager posts a NIP-52 calendar event, it
      will appear here after the next rebuild.
    </p>
  )}
</Layout>

<style>
  /* Floating glass panel matching the projects section. */
  .events-panel {
    margin-bottom: 3rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border-radius: 12px;
    
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    backdrop-filter: blur(1px) saturate(100%);
    border: 1px solid rgba(26, 26, 26, 0.12);
    box-shadow:
      0 24px 48px -16px rgba(26, 26, 26, 0.22),
      0 12px 28px -12px rgba(26, 26, 26, 0.16),
      0 2px 8px rgba(26, 26, 26, 0.08);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .events-panel {
      background: var(--bg-soft-fallback);
    }
  }
  @media (max-width: 480px) {
    .events-panel {
      padding: 0.9rem 0.9rem 1.1rem;
    }
    .filter-bar {
      gap: 0.9rem;
    }
    .events-list {
      max-height: 520px;
    }
  }
  .page-lead {
    color: var(--muted);
    max-width: 62ch;
    margin: 0;
  }
  .filter-bar {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    overflow-x: auto;
    margin: 0 0 1.25rem 0;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgba(26, 26, 26, 0.12);
  }
  .filter-btn {
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: none;
    border: none;
    padding: 0;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
  }
  .filter-btn:hover {
    color: var(--fg);
  }
  .filter-btn.is-active {
    color: var(--accent);
  }
  .filter-count {
    opacity: 0.7;
    margin-left: 0.3rem;
  }
  .events-wrap {
    position: relative;
  }
  .events-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 600px;
    overflow-y: auto;
    padding-right: 0.5rem;
    scroll-snap-type: y proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
  }
  .events-list::-webkit-scrollbar {
    width: 8px;
  }
  .events-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .events-list::-webkit-scrollbar-thumb {
    background: var(--accent);
  }
  .events-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .events-group[hidden] {
    display: none;
  }
  .events-group-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .events-group-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: rgba(26, 26, 26, 0.12);
  }
  .events-group-label--past {
    color: var(--muted-2);
  }
  .events-list :global(.event-card) {
    scroll-snap-align: start;
    flex-shrink: 0;
  }
  .events-list :global(.event-card[hidden]) {
    display: none;
  }
  .events-fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 48px;
    background: linear-gradient(
      to bottom,
      rgba(240, 238, 231, 0),
      rgba(240, 238, 231, 0.92)
    );
    pointer-events: none;
  }
</style>

<script>
  const CATEGORY_STEMS: Record<string, string> = {
    seminars: "seminar",
    workshops: "workshop",
    bitdevs: "bitdev",
  };

  const filterButtons = document.querySelectorAll<HTMLButtonElement>(
    ".filter-bar .filter-btn"
  );
  const cards = document.querySelectorAll<HTMLElement>(
    "[data-events-grid] .event-card"
  );
  const groups = document.querySelectorAll<HTMLElement>("[data-group]");
  const emptyMessage = document.querySelector<HTMLElement>("[data-events-empty]");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter ?? "all";
      const stem = CATEGORY_STEMS[filter];

      filterButtons.forEach((b) => {
        b.classList.toggle("is-active", b === button);
        b.setAttribute("aria-selected", String(b === button));
      });

      let visible = 0;
      cards.forEach((card) => {
        const tags = (card.dataset.tags ?? "").split(" ").filter(Boolean);
        const matches =
          filter === "all" ||
          (stem !== undefined && tags.some((t) => t.startsWith(stem)));
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      // Collapse an Upcoming/Past section (including its divider label)
      // when the current category filter leaves it without visible cards.
      groups.forEach((group) => {
        const groupCards = group.querySelectorAll<HTMLElement>(".event-card");
        const anyVisible = Array.from(groupCards).some((c) => !c.hidden);
        group.hidden = !anyVisible;
      });

      if (emptyMessage) emptyMessage.hidden = visible > 0;
    });
  });
</script>

<script>
  // NIP-52 event RSVPs, signed client-side via NIP-07 (window.nostr) —
  // the site stays keyless (architecture.md §2): members sign with their
  // own extension and the signed event is published to the club relays.
  import { SimplePool } from "nostr-tools";

  const grid = document.querySelector<HTMLElement>("[data-events-grid]");
  if (grid) {
    const CLUB_PUBKEY = grid.dataset.clubPubkey ?? "";
    const RELAYS: string[] = JSON.parse(grid.dataset.relays ?? "[]");
    const nostr = (window as unknown as { nostr?: NIP07 }).nostr;
    const pool = new SimplePool();

    interface NIP07 {
      getPublicKey(): Promise<string>;
      signEvent(event: {
        kind: number;
        created_at: number;
        tags: string[][];
        content: string;
      }): Promise<{ id: string; pubkey: string; sig: string; [k: string]: unknown }>;
    }

    const rsvpRows = Array.from(grid.querySelectorAll<HTMLElement>("[data-rsvp]"));

    const cacheKey = (address: string) => `rsvp:${address}`;

    const activate = (row: HTMLElement, status: string) => {
      row.querySelectorAll<HTMLButtonElement>(".rsvp-btn").forEach((b) => {
        b.classList.toggle("rsvp-btn--active", b.dataset.rsvpStatus === status);
      });
    };

    const enableForNIP07 = () => {
      rsvpRows.forEach((row) => {
        if (nostr) {
          row.querySelectorAll<HTMLButtonElement>(".rsvp-btn").forEach((b) => {
            b.disabled = false;
          });
        } else {
          row.querySelectorAll<HTMLButtonElement>(".rsvp-btn").forEach((b) => {
            b.disabled = true;
            b.title = "Install a Nostr browser extension (NIP-07) to RSVP";
          });
          row.querySelector<HTMLElement>("[data-rsvp-hint]")?.removeAttribute("hidden");
        }
        const saved = localStorage.getItem(cacheKey(row.dataset.eventAddress ?? ""));
        if (saved) activate(row, saved);
      });
    };

    const publishRsvp = async (row: HTMLElement, status: string) => {
      if (!nostr) return;
      const calKind = Number(row.dataset.eventKind);
      const address = row.dataset.eventAddress ?? "";
      const eventId = row.dataset.eventId ?? "";

      const event = {
        // 31922 calendar events pair with 31924 RSVPs, 31923 with 31925.
        kind: calKind === 31922 ? 31924 : 31925,
        created_at: Math.floor(Date.now() / 1000),
        tags: [
          ["d", address],
          ["a", address],
          ["e", eventId],
          ["status", status],
        ],
        content: "",
      };

      const buttons = row.querySelectorAll<HTMLButtonElement>(".rsvp-btn");
      buttons.forEach((b) => (b.disabled = true));
      try {
        const signed = await nostr.signEvent(event);
        // Resolves once any relay accepts the signed event.
        await Promise.any(pool.publish(RELAYS, signed));
        activate(row, status);
        localStorage.setItem(cacheKey(address), status);
      } catch {
        row.querySelector<HTMLElement>("[data-rsvp-hint]")?.removeAttribute("hidden");
      } finally {
        buttons.forEach((b) => {
          if (!b.classList.contains("rsvp-btn--active")) b.disabled = !nostr;
        });
      }
    };

    rsvpRows.forEach((row) => {
      row.querySelectorAll<HTMLButtonElement>(".rsvp-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (btn.classList.contains("rsvp-btn--active")) return;
          publishRsvp(row, btn.dataset.rsvpStatus ?? "accepted");
        });
      });
    });

    enableForNIP07();
  }
</script>
