---
export interface Props {
  project: {
    id: string;
    status: string;
    title: string;
    description: string;
    contributors: string;
    linkLabel: string;
    linkUrl: string;
  };
}

const { project } = Astro.props;
const badgeClass = `badge badge--${project.status.toLowerCase()}`;
---

<article class="project-card">
  <div class="project-card-head">
    <span class="project-id">{project.id}</span>
    <span class={badgeClass}>{project.status}</span>
  </div>
  <h3 class="project-title">{project.title}</h3>
  <p class="project-description">{project.description}</p>
  <div class="project-contributors">
    <p class="label">CONTRIBUTORS</p>
    <p>{project.contributors}</p>
  </div>
  <a class="btn btn--outline btn--block" href={project.linkUrl} target="_blank" rel="noopener noreferrer">
    {project.linkLabel}
  </a>
</article>

<style>
  .project-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .project-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .project-title {
    font-size: 1.1rem;
    text-transform: uppercase;
    margin: 0 0 0.75rem 0;
  }
  .project-description {
    flex: 1;
    margin: 0 0 1rem 0;
  }
  .project-contributors {
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }
  .project-contributors .label {
    color: var(--muted);
    font-size: 0.7rem;
    margin: 0 0 0.25rem 0;
  }
  .project-contributors p:last-child {
    margin: 0;
  }
</style>
