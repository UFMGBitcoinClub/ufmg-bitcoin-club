---
import { nip19 } from "nostr-tools";

export interface Props {
  project: {
    id: string;
    d: string;
    title: string;
    status: string;
    type: string;
    description: string;
    linkUrl: string | null;
    contributors: string[];
    tags: string[];
  };
}

const { project } = Astro.props;

const KNOWN_BADGES: Record<string, string> = {
  PUBLISHED: "chip--published",
  ACTIVE: "chip--active",
  MERGED: "chip--merged",
};
const badgeClass = `chip ${KNOWN_BADGES[project.status.toUpperCase()] ?? ""}`.trim();

const KNOWN_LINK_LABELS: Record<string, string> = {
  paper: "Fetch paper.pdf",
  repo: "See repository",
  pr: "View pull request",
};
const linkLabel = KNOWN_LINK_LABELS[project.type.toLowerCase()] ?? "View external link";

// Short hex-looking id derived from the event id, purely decorative —
// echoes the "0x1A4C" style tags in the mockup.
const hexTag = `0x${project.id.slice(0, 4).toUpperCase()}`;

function npubOf(pk: string): string | null {
  try {
    return nip19.npubEncode(pk);
  } catch {
    return null;
  }
}

const contributors = project.contributors.map((pk) => {
  const npub = npubOf(pk);
  return {
    label: npub
      ? `${npub.slice(0, 14)}...${npub.slice(-4)}`
      : `${pk.slice(0, 8)}...${pk.slice(-4)}`,
    npub,
    href: npub ? `https://njump.me/${npub}` : null,
  };
});
---

<article class="project-card" data-project-type={project.type.toLowerCase()}>
  <div class="project-card-head">
    <span class={badgeClass}>[ {project.status} ]</span>
    <span class="project-hex">{hexTag}</span>
  </div>
  <h3 class="project-title">{project.title}</h3>
  <p class="project-description">{project.description}</p>
  {project.tags.length > 0 && (
    <div class="project-tags">
      {project.tags.map((tag) => <span class="project-tag">#{tag}</span>)}
    </div>
  )}
  {contributors.length > 0 && (
    <div class="project-contributors">
      <p class="mono-label">Contributors</p>
      <ul class="contributor-list">
        {contributors.map((c) => (
          <li>
            {c.href ? (
              <a
                class="contributor-npub"
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                title={c.npub ?? c.label}
              >
                {c.label}
              </a>
            ) : (
              <span class="contributor-npub">{c.label}</span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )}
  {project.linkUrl ? (
    <a class="btn btn--outline btn--block" href={project.linkUrl} target="_blank" rel="noopener noreferrer">
      {linkLabel}
      <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
    </a>
  ) : (
    <p class="empty">No external link provided.</p>
  )}
</article>

<style>
  .project-card {
    padding: 1.5rem;
    border-left: 4px solid var(--accent);
    display: flex;
    flex-direction: column;
    min-height: 260px;
    transition: border-left-width 0.2s;
  }
  .project-card:hover {
    border-left-width: 6px;
  }
  .project-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .project-hex {
    font-size: 0.72rem;
    color: var(--muted);
  }
  .project-title {
    font-size: 1.1rem;
    text-transform: uppercase;
    margin: 0 0 0.75rem 0;
  }
  .project-description {
    flex: 1;
    margin: 0 0 1rem 0;
    color: var(--muted);
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .project-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }
  .project-contributors {
    border-top: 1px solid var(--border-soft);
    padding-top: 0.75rem;
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }
  .contributor-list {
    list-style: none;
    margin: 0.35rem 0 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .contributor-npub {
    display: inline-block;
    font-size: 0.7rem;
    color: var(--muted);
    background: var(--bg-alt);
    border: 1px dashed var(--border-soft);
    padding: 0.25rem 0.5rem;
    text-decoration: none;
  }
  a.contributor-npub:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
