---
import { NAV_ITEMS } from "../lib/nav.js";
import { withBase } from "../lib/url.js";

export interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="logo" href={withBase("/")}>
      <img
        class="logo-icon"
        src={withBase("/svg/Libertas.svg")}
        alt=""
        width="56"
        height="56"
      />
      <p>UFMG <span class="logo-name">Bitcoin</span> Club</p> 
    </a>
    <nav class="nav-list">
      {
        NAV_ITEMS.map((item) => (
          <a
            class={`nav-link ${active === item.key ? "nav-link--active" : ""}`}
            href={withBase(item.href)}
          >
            [ {item.label} ]
          </a>
        ))
      }
    </nav>
  </div>
</header>
