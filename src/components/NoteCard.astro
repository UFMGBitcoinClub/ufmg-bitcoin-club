---
export interface FeedItem {
  type: "note" | "repost";
  id: string;
  created_at: number;
  pubkey?: string;
  content?: string;
  original?: {
    id: string;
    pubkey: string;
    created_at: number;
    content: string;
  };
}

export interface Props {
  item: FeedItem;
  avatarUrl?: string | null;
  authorNames?: Record<string, string>;
}

const { item, avatarUrl, authorNames } = Astro.props;

const isRepost = item.type === "repost";
const displayContent = (
  isRepost ? item.original!.content : item.content ?? ""
).trim();
const displayId = isRepost ? item.original!.id : item.id;
const displayCreatedAt = isRepost ? item.original!.created_at : item.created_at;
const displayPubkey = isRepost ? item.original!.pubkey : item.pubkey ?? "";

function shortId(id: string): string {
  return `${id.slice(0, 8)}...${id.slice(-4)}`;
}

function shortName(name: string): string {
  return name.length > 24 ? `${name.slice(0, 23)}…` : name;
}

function initials(name: string): string {
  const words = name.trim().split(/\s+/).filter(Boolean);
  if (words.length === 0) return "??";
  if (words.length === 1) return words[0].slice(0, 2).toUpperCase();
  return (words[0][0] + words[1][0]).toUpperCase();
}

function timeAgo(unixSeconds: number): string {
  const diffMs = Date.now() - unixSeconds * 1000;
  const mins = Math.floor(diffMs / 60000);
  if (mins < 1) return "just now";
  if (mins < 60) return `${mins}m ago`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours}h ago`;
  const days = Math.floor(hours / 24);
  return `${days}d ago`;
}

// Resolve a human-readable author name from the pubkey → name map passed
// by the page (club profile + member roster). Unknown authors gracefully
// fall back to a truncated pubkey so the card never shows a blank label.
const authorName = authorNames?.[displayPubkey] ?? null;
const displayAuthor = authorName
  ? shortName(authorName)
  : displayPubkey
    ? shortId(displayPubkey)
    : shortId(displayId);
const avatarText = initials(authorName ?? displayAuthor);

// content may embed hashtags inline (e.g. "#zkp #ufmg") — the mockup shows
// these as a separate tag line, so we surface any trailing #word tokens.
const hashtagMatches = displayContent.match(/#\w+/g) ?? [];
const njumpUrl = `https://njump.me/${displayId}`;
---

<article class="note-card">
  <div class="note-meta">
    <div class="note-author">
      {avatarUrl && !isRepost ? (
        <img
          class="note-avatar note-avatar--img"
          src={avatarUrl}
          alt=""
          loading="lazy"
          width="34"
          height="34"
        />
      ) : (
        <span class="note-avatar">{avatarText}</span>
      )}
      <span class="note-author-text">
        <span class="note-name">{displayAuthor}</span>
        <span class="note-sub">{isRepost ? "reposted" : "kind: 1 note"}</span>
      </span>
    </div>
    <div class="note-meta-right">
      <span class="note-time">{timeAgo(displayCreatedAt)}</span>
      <a class="view-external" href={njumpUrl} target="_blank" rel="noopener noreferrer" aria-label="View on njump">
        <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
      </a>
    </div>
  </div>
  <p class="note-content">{displayContent}</p>
  {hashtagMatches.length > 0 && (
    <div class="note-tags">
      {hashtagMatches.map((tag) => <span class="note-tag">{tag}</span>)}
    </div>
  )}
  <div class="note-footer">
    <span>id: {shortId(displayId)}</span>
    <a href={njumpUrl} target="_blank" rel="noopener noreferrer">verify ↗</a>
  </div>
</article>

<style>
  .note-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border-soft);
    border-radius: 3px;
    background: var(--accent-soft-bg);
    box-shadow:
      0 10px 24px -14px rgba(23, 19, 13, 0.28),
      0 2px 6px -2px rgba(23, 19, 13, 0.12);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }
  .note-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow:
      0 16px 32px -14px rgba(23, 19, 13, 0.35),
      0 4px 10px -4px rgba(23, 19, 13, 0.15);
  }
  .note-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.65rem;
  }
  .note-author {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
  }
  .note-avatar {
    width: 2.125rem;
    height: 2.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--fg);
    color: var(--bg);
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }
  .note-avatar--img {
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid var(--accent-soft-bg);
    box-shadow: 0 0 0 1px var(--border-soft);
  }
  .note-card:nth-of-type(even) .note-avatar {
    background: var(--primary);
  }
  .note-author-text {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
    min-width: 0;
  }
  .note-name {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .note-sub {
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .note-meta-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .note-time {
    font-variant-numeric: tabular-nums;
  }
  .view-external {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    color: var(--muted);
    background: var(--bg);
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }
  .view-external .material-symbols-outlined {
    font-size: 0.95rem;
  }
  .view-external:hover {
    color: var(--accent-dim);
    border-color: var(--accent);
    background: var(--accent-soft-bg);
  }
  .note-content {
    flex: 1;
    min-height: 0;
    margin: 0 0 0.75rem 0;
    font-size: var(--fs-body-md);
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--fg);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
  }
  .note-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin: 0 0 0.6rem 0;
  }
  .note-tag {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--accent-dim);
    background: var(--accent-soft-bg);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }
  .note-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding-top: 0.6rem;
    border-top: 1px dashed var(--border-soft);
    font-size: 0.68rem;
    line-height: 1.4;
    color: var(--muted-2);
    white-space: nowrap;
    overflow: hidden;
  }
  .note-footer a {
    color: var(--muted-2);
    text-decoration: none;
    transition: color 0.15s;
  }
  .note-footer a:hover {
    color: var(--accent-dim);
  }
  @media (max-width: 480px) {
    .note-card {
      padding: 0.85rem 1rem;
    }
    .note-avatar {
      width: 1.75rem;
      height: 1.75rem;
      font-size: 0.6rem;
    }
    .note-name {
      font-size: 0.78rem;
    }
    .note-sub {
      font-size: 0.58rem;
    }
    .note-meta {
      margin-bottom: 0.5rem;
    }
    .note-meta-right {
      gap: 0.4rem;
      font-size: 0.65rem;
    }
    .view-external {
      width: 1.6rem;
      height: 1.6rem;
    }
    .view-external .material-symbols-outlined {
      font-size: 0.8rem;
    }
  }
</style>
