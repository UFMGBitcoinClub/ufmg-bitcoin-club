---
export interface Props {
  member: {
    pubkey: string;
    name: string | null;
    picture: string | null;
    about: string | null;
    nip05: string | null;
    githubUrl: string | null;
    linkedinUrl: string | null;
  };
}

const { member } = Astro.props;
const npubLink = `https://njump.me/${member.pubkey}`;

function shortPubkey(pubkey: string): string {
  return `${pubkey.slice(0, 8)}...${pubkey.slice(-5)}`;
}

function initials(name: string | null): string {
  if (!name) return "??";
  return name.slice(0, 2).toUpperCase();
}
---

<article class="member-card">
  <div class="member-head">
    {member.picture ? (
      <img class="member-avatar" src={member.picture} alt={member.name ?? "Member avatar"} />
    ) : (
      <div class="member-avatar member-avatar--placeholder" aria-hidden="true">
        {initials(member.name)}
      </div>
    )}
    <div>
      <h3 class="member-name">{member.name ?? "Unnamed"}</h3>
      {member.nip05 && <div class="member-nip05">&lt; {member.nip05} &gt;</div>}
    </div>
  </div>
  {member.about && <p class="member-about">{member.about}</p>}
  <div class="member-npub">{shortPubkey(member.pubkey)}</div>
  <div class="member-links">
    <a class="btn btn--outline btn--small" href={npubLink} target="_blank" rel="noopener noreferrer">
      [ View profile ]
    </a>
    {member.githubUrl && (
      <a class="btn btn--outline btn--small" href={member.githubUrl} target="_blank" rel="noopener noreferrer">
        &lt;&gt; GitHub
      </a>
    )}
    {member.linkedinUrl && (
      <a class="btn btn--outline btn--small" href={member.linkedinUrl} target="_blank" rel="noopener noreferrer">
        in LinkedIn
      </a>
    )}
  </div>
</article>

<style>
  .member-card {
    padding: 1.5rem;
    border-left: 4px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .member-head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .member-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
    flex-shrink: 0;
    filter: grayscale(1);
  }
  .member-avatar--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-alt);
    color: var(--muted);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .member-name {
    font-size: 1rem;
    text-transform: uppercase;
    margin: 0 0 0.25rem 0;
  }
  .member-nip05 {
    font-size: 0.78rem;
    color: var(--accent);
  }
  .member-about {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .member-npub {
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--bg-alt);
    border: 1px dashed var(--border-soft);
    padding: 0.5rem 0.7rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .member-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .member-links a {
    flex: 1;
    text-align: center;
  }
</style>
