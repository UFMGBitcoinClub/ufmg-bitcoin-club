---
export interface Props {
  member: {
    pubkey: string;
    name: string | null;
    picture: string | null;
    about: string | null;
    nip05: string | null;
    githubUrl: string | null;
    linkedinUrl: string | null;
    joinedAt?: string | null;
    attendance?: { rsvp?: string[]; checkin?: string[] };
  };
  badges?: { id: string; name: string }[];
}

const { member, badges = [] } = Astro.props;
const npubLink = `https://njump.me/${member.pubkey}`;

function shortPubkey(pubkey: string): string {
  return `${pubkey.slice(0, 8)}...${pubkey.slice(-5)}`;
}

function initials(name: string | null): string {
  if (!name) return "??";
  return name.slice(0, 2).toUpperCase();
}

function memberSince(iso: string | null | undefined): string | null {
  if (!iso) return null;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return null;
  return new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric" }).format(d);
}

const since = memberSince(member.joinedAt ?? null);
const rsvpCount = member.attendance?.rsvp?.length ?? 0;
const checkinCount = member.attendance?.checkin?.length ?? 0;
---

<article class="member-card ">
  <div class="member-head">
    {member.picture ? (
      <img class="member-avatar" src={member.picture} alt={member.name ?? "Member avatar"} />
    ) : (
      <div class="member-avatar member-avatar--placeholder" aria-hidden="true">
        {initials(member.name)}
      </div>
    )}
    <div class="member-head-text">
      <h3 class="member-name">{member.name ?? "Unnamed"}</h3>
      {member.nip05 && <div class="member-nip05">&lt; {member.nip05} &gt;</div>}
      {badges.length > 0 && (
        <div class="member-badges">
          {badges.map((b) => (
            <span class="chip" title={`NIP-58 badge: ${b.id}`}>[ {b.name.toUpperCase()} ]</span>
          ))}
        </div>
      )}
    </div>
  </div>
  {member.about && <p class="member-about">{member.about}</p>}
  <div class="member-meta">
    <div class="member-npub" title={member.pubkey}>{shortPubkey(member.pubkey)}</div>
    {(rsvpCount > 0 || checkinCount > 0) && (
      <p
        class="member-attendance mono-label"
        title="Self-attested evidence (NIP-52 RSVPs and check-in notes referencing club events)"
      >
        RSVP {rsvpCount} · CHECK-IN {checkinCount}
      </p>
    )}
    {since && <p class="member-since mono-label">member since {since}</p>}
  </div>
  <div class="member-links">
    <a class="btn btn--outline btn--small" href={npubLink} target="_blank" rel="noopener noreferrer">
      [ View ]
    </a>
    {member.githubUrl && (
      <a class="btn btn--outline btn--small" href={member.githubUrl} target="_blank" rel="noopener noreferrer">
        &lt;GitHub&gt;
      </a>
    )}
    {member.linkedinUrl && (
      <a class="btn btn--outline btn--small" href={member.linkedinUrl} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
    )}
  </div>
</article>

<style>
  .member-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.375rem;
    border-radius: 12px;
    background: var(--accent-soft-bg);
    box-shadow:
      0 10px 24px -14px rgba(23, 19, 13, 0.28),
      0 2px 6px -2px rgba(23, 19, 13, 0.12);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
  }
  .member-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow:
      0 16px 32px -14px rgba(23, 19, 13, 0.35),
      0 4px 10px -4px rgba(23, 19, 13, 0.15);
  }
  .member-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .member-head-text {
    min-width: 0;
  }
  .member-avatar {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--bg-raised);
    box-shadow: 0 0 0 1px var(--border-soft);
    flex-shrink: 0;
  }
  .member-avatar--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-raised);
    color: var(--muted);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .member-name {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 0.15rem 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .member-nip05 {
    font-size: 0.72rem;
    color: var(--accent);
  }
  .member-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.4rem;
  }
  .member-about {
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--muted);
    margin: 0 0 1rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 50%, transparent 96%);
    mask-image: linear-gradient(to bottom, #000 50%, transparent 96%);
  }
  .member-meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    border-top: 1px dashed var(--border-soft);
    padding-top: 0.75rem;
    margin-bottom: 1rem;
  }
  .member-npub {
    font-size: 0.68rem;
    color: var(--muted);
    background: var(--bg-raised);
    border: 1px dashed var(--border-soft);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .member-attendance,
  .member-since {
    margin: 0;
    font-size: 0.7rem;
    color: var(--muted-2);
  }
  .member-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
  }
  .member-links a {
    flex: 1;
    text-align: center;
  }
</style>
