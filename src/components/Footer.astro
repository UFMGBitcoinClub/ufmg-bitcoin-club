---
// TODO: point these at the club's real destinations (repo, relay, contact
// form) once they exist.
const footerLinks = [
  { label: "Whitepapers", href: "#" },
  { label: "GitHub", href: "#" },
  { label: "Nostr", href: "#" },
  { label: "Contact", href: "#" },
];

const year = new Date().getFullYear();
---

