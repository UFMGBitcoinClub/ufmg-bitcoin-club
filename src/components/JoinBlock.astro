---
// NOTE: this is a static site with no backend of its own (architecture.md
// §1/§8). A plain <form> here has nowhere to submit to. Before shipping,
// point `action` at a free static-form backend (e.g. Formspree) or swap
// the input+button for a mailto: link — don't wire fake client-side JS
// that only *looks* functional.
---

<section class="join-block panel--muted">
  <h2 class="section-title center">Join the Network</h2>
  <p class="center">
    We are open to students, researchers, and builders who share our vision of a
    decentralized future.
  </p>
  <form class="join-form" action="#" method="post">
    <input type="text" name="contact" placeholder="Enter your npub or email..." required />
    <button type="submit" class="btn btn--primary">INITIATE</button>
  </form>
</section>

<style>
  .join-block {
    margin: 2.5rem 0;
    text-align: center;
  }
  .join-block p {
    max-width: 46ch;
    margin: 0 auto 1.5rem auto;
  }
  .join-form {
    display: flex;
    justify-content: center;
    gap: 0;
    max-width: 480px;
    margin: 0 auto;
  }
  .join-form input {
    flex: 1;
    font-family: inherit;
    font-size: 0.85rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-right: none;
    background: var(--bg);
    color: var(--fg);
  }
  .join-form input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .join-form .btn {
    border-radius: 0;
  }
  .center {
    text-align: center;
  }
  @media (max-width: 480px) {
    .join-form {
      flex-direction: column;
    }
    .join-form input {
      border-right: 1px solid var(--border);
    }
  }
</style>
