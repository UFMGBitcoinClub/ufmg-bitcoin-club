---
import { withBase } from "../lib/url.js";
---

<section class="join-block corner-accent">
  <h2 class="section-title center">Join the Consensus</h2>
  <p class="center">
    Enter the protocol. Connect with fellow researchers, developers, and
    sovereign individuals dedicated to the study and advancement of Bitcoin
    in the UFMG ecosystem.
  </p>
  <div class="join-cta">
    <a class="btn btn--dark" href={withBase("/join")}>Join us</a>
  </div>
</section>

<style>
  .join-block {
    margin: 3rem 0 2.5rem 0;
    padding: 2.5rem 2rem;
    text-align: center;
    background: var(--accent-soft-bg);
    
    box-shadow: 0 24px 48px -16px rgba(26, 26, 26, 0.22), 0 12px 28px -12px rgba(26, 26, 26, 0.16), 0 2px 8px rgba(26, 26, 26, 0.08);
  }
  .join-block .section-title {
    font-size: 1.6rem;
  }
  .join-block p {
    max-width: 46ch;
    margin: 0 auto 1.5rem auto;
    color: var(--muted);
  }
  .join-cta {
    display: flex;
    justify-content: center;
  }
  .center {
    text-align: center;
  }
</style>
