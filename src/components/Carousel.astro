---
// Generic horizontal "passable" list. The scrolling itself is pure CSS
// (scroll-snap) so it works by touch/trackpad/keyboard with zero JS.
export interface Props {
  ariaLabel: string;
}

const { ariaLabel } = Astro.props;
---

<div class="carousel" aria-label={ariaLabel}>
  <div class="carousel-track" data-carousel-track>
    <slot />
  </div>
</div>

<style>
  .carousel {
    position: relative;
  }
  /* Edge fades hinting there's more to scroll sideways. Pages can
     override --carousel-fade to blend with a tinted panel background. */
  .carousel::before,
  .carousel::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2.5rem;
    z-index: 1;
    pointer-events: none;
  }
  .carousel::before {
    left: 0;
    background: linear-gradient(to right, var(--carousel-fade, rgba(252, 249, 242, 0.95)), rgba(252, 249, 242, 0));
  }
  .carousel::after {
    right: 0;
    background: linear-gradient(to left, var(--carousel-fade, rgba(252, 249, 242, 0.95)), rgba(252, 249, 242, 0));
  }
  .carousel-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scroll-behavior: smooth;
    padding: 0.25rem 0.25rem 1rem 0.25rem;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) var(--bg-alt);
  }
  .carousel-track::-webkit-scrollbar {
    height: 6px;
  }
  .carousel-track::-webkit-scrollbar-track {
    background: var(--bg-alt);
  }
  .carousel-track::-webkit-scrollbar-thumb {
    background: var(--accent);
  }
  /* Each direct child of the slotted content becomes a fixed-width,
     snap-aligned "page" of the carousel. */
  .carousel-track > :global(*) {
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: min(320px, 82vw);
  }
</style>
