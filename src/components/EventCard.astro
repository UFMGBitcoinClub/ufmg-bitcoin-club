---
export interface Props {
  event: {
    id: string;
    title: string;
    startMs: number;
    endMs: number | null;
    location: string | null;
    description: string;
    tags: string[];
    dateOnly: boolean;
  };
  status: "upcoming" | "past";
}

const { event, status } = Astro.props;
const isPast = status === "past";

const dateLabel = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
}).format(new Date(event.startMs));

const timeLabel = event.dateOnly
  ? null
  : new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      timeZoneName: "short",
    }).format(new Date(event.startMs));

// External link only — opens the raw calendar event on a public Nostr
// viewer, which lets the visitor's own client take over. No signing or
// wallet-connect happens on this site (architecture.md §2).
const nostrLink = `https://njump.me/${event.id}`;
---

<article
  class={`event-card ${isPast ? "event-card--past" : ""}`}
  data-tags={event.tags.map((t) => t.toLowerCase()).join(" ")}
>
  <div class="event-dot" aria-hidden="true"></div>
  <div class="event-head">
    <div class="event-head-left">
      <div class="event-head-tags">
        {event.tags.length > 0 && (
          <span class="event-type">&lt; {event.tags[0].toUpperCase()} &gt;</span>
        )}
        <span class={`badge ${isPast ? "badge--archived" : "badge--active"}`}>
          {isPast ? "[ PAST ]" : "[ UPCOMING ]"}
        </span>
      </div>
      <h3 class="event-title">{event.title}</h3>
    </div>
    <div class="event-when">
      <p class="event-date">
        <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
        {dateLabel}{timeLabel ? `, ${timeLabel}` : ""}
      </p>
      {event.location && (
        <p class="event-location">
          <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
          {event.location}
        </p>
      )}
    </div>
  </div>

  <p class="event-description">{event.description}</p>

  <div class="event-meta-row">
    <span>EVENT ID: {event.id.slice(0, 10)}...{event.id.slice(-4)}</span>
    {event.tags.length > 0 && (
      <span>TAGS: {event.tags.map((t) => `#${t}`).join(" ")}</span>
    )}
  </div>

  <div class="event-action">
    <a class="view-external" href={nostrLink} target="_blank" rel="noopener noreferrer">
      <span class="view-external-text">[ VIEW EXTERNAL ]</span>
      <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
    </a>
  </div>
</article>

<style>
  .event-card {
    position: relative;
    padding: 1.5rem 0 1.5rem 1.25rem;
    border-left: 4px solid var(--accent);
    border-bottom: 1px solid var(--border-soft);
  }
  .event-dot {
    display: none;
  }
  .event-head-tags {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .event-type {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--muted);
  }
  .event-card--past {
    border-left-color: var(--border-soft);
    opacity: 0.85;
  }
  .event-head {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .event-head-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }
  .event-title {
    text-transform: uppercase;
    font-size: 1.15rem;
    margin: 0;
  }
  .event-card--past .event-title {
    color: var(--muted);
  }
  .event-when {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .event-date {
    margin: 0 0 0.25rem 0;
    font-weight: 700;
    color: var(--fg);
  }
  .event-card--past .event-date {
    color: var(--muted);
  }
  .event-location {
    margin: 0;
  }
  .event-description {
    margin: 0 0 1rem 0;
    max-width: 62ch;
    color: var(--muted);
  }
  .event-meta-row {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    background: var(--bg-alt);
    padding: 0.6rem 0.9rem;
    font-size: 0.72rem;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .event-action {
    display: flex;
    justify-content: flex-end;
  }
  .event-date .material-symbols-outlined,
  .event-location .material-symbols-outlined {
    font-size: 14px;
    vertical-align: -2px;
    margin-right: 0.3rem;
  }
  .event-card:not(.event-card--past) .event-date .material-symbols-outlined {
    color: var(--accent);
  }
  @media (min-width: 769px) {
    .event-dot {
      display: block;
      position: absolute;
      top: 0;
      right: 0;
      width: 8px;
      height: 8px;
      background: var(--fg);
      transition: background-color 0.15s;
    }
    .event-card--past .event-dot {
      background: var(--border-soft);
    }
    .event-card:hover .event-dot {
      background: var(--accent);
    }
    .event-head {
      flex-direction: row;
      align-items: flex-start;
    }
    .event-when {
      text-align: right;
    }
  }
</style>
