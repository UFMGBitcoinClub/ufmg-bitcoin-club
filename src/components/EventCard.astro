---
export interface Props {
  event: {
    id: string;
    kind: number;
    d: string;
    title: string;
    startMs: number;
    endMs: number | null;
    location: string | null;
    image: string | null;
    description: string;
    tags: string[];
    dateOnly: boolean;
  };
  status: "upcoming" | "past";
  rsvp?: { going: number; tentative: number; declined: number };
}

const { event, status, rsvp } = Astro.props;
const isPast = status === "past";

const dateLabel = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
}).format(new Date(event.startMs));

const timeLabel = event.dateOnly
  ? null
  : new Intl.DateTimeFormat("en-GB", {
      hour: "2-digit",
      minute: "2-digit",
      timeZoneName: "short",
    }).format(new Date(event.startMs));

function shortId(id: string): string {
  return `${id.slice(0, 8)}...${id.slice(-4)}`;
}

// External link — opens the raw calendar event on a public Nostr
// viewer, which lets the visitor's own client take over.
const nostrLink = `https://njump.me/${event.id}`;

const goingCount = rsvp?.going ?? 0;
const tentativeCount = rsvp?.tentative ?? 0;
const showRsvpCount = goingCount > 0 || tentativeCount > 0;

// NIP-52 replaceable address of the calendar event — used by the RSVP
// script as the `d`/`a` reference and the localStorage cache key.
const eventAddress = `${event.kind}:${event.d}`;
---

<article
  class={`event-card ${isPast ? "event-card--past" : ""} ${event.image ? "event-card--media" : ""}`}
  data-tags={event.tags.map((t) => t.toLowerCase()).join(" ")}
>
  {event.image && (
    <div class="event-media">
      <img
        src={event.image}
        alt={`Banner for ${event.title}`}
        loading="lazy"
      />
    </div>
  )}

  <div class="event-body">
    <div class="event-head">
      <div class="event-head-left">
        <div class="event-head-tags">
          <span class={`badge ${isPast ? "badge--archived" : "badge--active"}`}>
            {isPast ? "[ PAST ]" : "[ UPCOMING ]"}
          </span>
          {showRsvpCount && (
            <span class="rsvp-chip" title="NIP-52 RSVPs referencing this event">
              <span class="material-symbols-outlined" aria-hidden="true">how_to_reg</span>
              {goingCount} going{tentativeCount > 0 ? ` · ${tentativeCount} maybe` : ""}
            </span>
          )}
        </div>
        <h3 class="event-title">{event.title}</h3>
        {event.tags.length > 0 && (
          <div class="event-tags">
            {event.tags.map((t) => <span class="event-tag">#{t}</span>)}
          </div>
        )}
      </div>
      <div class="event-when">
        <p class="event-date">
          <span class="material-symbols-outlined" aria-hidden="true">calendar_today</span>
          {dateLabel}{timeLabel ? `, ${timeLabel}` : ""}
        </p>
        {event.location && (
          <p class="event-location">
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            {event.location}
          </p>
        )}
      </div>
    </div>

    <p class="event-description">{event.description}</p>

    {!isPast && (
      <div
        class="rsvp-row"
        data-rsvp
        data-event-id={event.id}
        data-event-kind={event.kind}
        data-event-address={eventAddress}
        data-event-title={event.title}
      >
        <div class="rsvp-buttons">
          <button
            class="rsvp-btn"
            type="button"
            data-rsvp-status="accepted"
            disabled
          >
            <span class="material-symbols-outlined" aria-hidden="true">check</span>
            Going
          </button>
          <button
            class="rsvp-btn"
            type="button"
            data-rsvp-status="tentative"
            disabled
          >
            <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
            Maybe
          </button>
        </div>
        <p class="rsvp-hint" data-rsvp-hint hidden>
          RSVP needs a Nostr browser extension (NIP-07) — try
          <a href="https://getalby.com" target="_blank" rel="noopener noreferrer">Alby</a> or
          <a href="https://github.com/nostrably/nos2x" target="_blank" rel="noopener noreferrer">nos2x</a>,
          or <a href={nostrLink} target="_blank" rel="noopener noreferrer">RSVP from your own client ↗</a>.
        </p>
      </div>
    )}

    <div class="event-meta-row">
      <span class="event-id" title={event.id}>EVENT ID: {shortId(event.id)}</span>
      <a class="view-external" href={nostrLink} target="_blank" rel="noopener noreferrer">
        <span class="view-external-text">[ VIEW ]</span>
        <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
      </a>
    </div>
  </div>
</article>

<style>
  .event-card {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    background: var(--accent-soft-bg);
    box-shadow:
      0 10px 24px -14px rgba(23, 19, 13, 0.28),
      0 2px 6px -2px rgba(23, 19, 13, 0.12);
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      border-color 0.18s ease;
    overflow: hidden;
  }
  .event-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow:
      0 16px 32px -14px rgba(23, 19, 13, 0.35),
      0 4px 10px -4px rgba(23, 19, 13, 0.15);
  }
  .event-card--past {
    background: var(--badge-archived-bg);
  }
  /* Banner media: top on mobile, square right column on desktop. */
  .event-media {
    position: relative;
    min-height: 0;
    aspect-ratio: 16 / 5;
    background: var(--bg-alt);
  }
  .event-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .event-body {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.375rem;
    min-width: 0;
  }
  .event-head {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .event-head-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    min-width: 0;
  }
  .event-head-tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .event-head-tags .badge {
    border-radius: 999px;
  }
  .rsvp-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    color: var(--accent-dim);
    background: var(--bg-raised);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }
  .rsvp-chip .material-symbols-outlined {
    font-size: 0.85rem;
  }
  .event-title {
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 1.1rem;
    margin: 0;
  }
  .event-card--past .event-title {
    color: var(--muted);
  }
  .event-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .event-tag {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
    color: var(--accent-dim);
    background: var(--bg-raised);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
  }
  .event-when {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .event-date {
    margin: 0 0 0.25rem 0;
    font-weight: 700;
    color: var(--fg);
  }
  .event-card--past .event-date {
    color: var(--muted);
  }
  .event-location {
    margin: 0;
  }
  .event-date .material-symbols-outlined,
  .event-location .material-symbols-outlined {
    font-size: 14px;
    vertical-align: -2px;
    margin-right: 0.3rem;
  }
  .event-card:not(.event-card--past) .event-date .material-symbols-outlined {
    color: var(--accent);
  }
  .event-description {
    margin: 0 0 1rem 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--muted);
  }

  .rsvp-row {
    margin-bottom: 1rem;
  }
  .rsvp-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .rsvp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: inherit;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--fg);
    background: var(--bg-raised);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s,
      opacity 0.15s;
  }
  .rsvp-btn .material-symbols-outlined {
    font-size: 0.95rem;
  }
  .rsvp-btn:hover:not(:disabled):not(.rsvp-btn--active) {
    color: var(--accent-dim);
    border-color: var(--accent);
    background: var(--accent-soft-bg);
  }
  .rsvp-btn.rsvp-btn--active {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent-dim);
    cursor: default;
  }
  .rsvp-btn:disabled:not(.rsvp-btn--active) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .rsvp-hint {
    margin: 0.5rem 0 0 0;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .rsvp-hint a {
    color: var(--accent-dim);
    text-decoration: none;
  }
  .rsvp-hint a:hover {
    text-decoration: underline;
  }

  .event-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 0.75rem;
    border-top: 1px dashed var(--border-soft);
    font-size: 0.72rem;
    color: var(--muted-2);
  }
  .event-id {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .view-external {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    background: var(--bg-raised);
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.15s,
      border-color 0.15s,
      background-color 0.15s;
  }
  .view-external .material-symbols-outlined {
    font-size: 0.9rem;
  }
  .view-external:hover {
    color: var(--accent-dim);
    border-color: var(--accent);
    background: var(--accent-soft-bg);
  }

  @media (min-width: 769px) {
    .event-card--media {
      /* 3:1 text-to-image split — square banner fills the right column. */
      grid-template-columns: 3fr 1fr;
      grid-template-areas: "body media";
    }
    .event-card--media .event-body {
      grid-area: body;
    }
    .event-card--media .event-media {
      grid-area: media;
      aspect-ratio: 1 / 1;
      height: 100%;
    }
    .event-head {
      flex-direction: row;
      align-items: flex-start;
    }
    .event-when {
      text-align: right;
      flex-shrink: 0;
    }
  }
  @media (max-width: 480px) {
    .event-media {
      aspect-ratio: 16 / 5;
    }
    .event-body {
      padding: 0.9rem 1rem;
    }
    .event-title {
      font-size: 0.95rem;
    }
    .event-meta-row {
      gap: 0.75rem;
      font-size: 0.65rem;
    }
    .view-external {
      padding: 0.25rem 0.55rem;
      font-size: 0.62rem;
    }
    .rsvp-btn {
      padding: 0.35rem 0.7rem;
      font-size: 0.65rem;
    }
  }
</style>
