---
export interface Props {
  displayName: string;
  about: string;
  manifestoUrl?: string;
  joinUrl?: string;
}

const { displayName, about, manifestoUrl = "#manifesto", joinUrl = "#join" } = Astro.props;
---

<section class="hero panel">
  <div class="hero-text">
    <h1 class="hero-title">{displayName}</h1>
    <p class="hero-about">{about}</p>
    <div class="hero-actions">
      <a class="btn btn--outline" href={manifestoUrl}>MANIFESTO</a>
      <a class="btn btn--primary" href={joinUrl}>JOIN</a>
    </div>
  </div>
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg">
      <g stroke="var(--fg)" stroke-width="0.5" opacity="0.35">
        <line x1="10" y1="20" x2="90" y2="60" />
        <line x1="90" y1="60" x2="160" y2="30" />
        <line x1="160" y1="30" x2="240" y2="55" />
        <line x1="240" y1="55" x2="300" y2="15" />
        <line x1="20" y1="120" x2="90" y2="60" />
        <line x1="20" y1="120" x2="80" y2="170" />
        <line x1="80" y1="170" x2="150" y2="150" />
        <line x1="150" y1="150" x2="160" y2="30" />
        <line x1="150" y1="150" x2="220" y2="190" />
        <line x1="220" y1="190" x2="240" y2="55" />
        <line x1="240" y1="55" x2="290" y2="140" />
        <line x1="290" y1="140" x2="220" y2="190" />
        <line x1="90" y1="60" x2="150" y2="150" />
      </g>
      <g fill="var(--fg)">
        <circle cx="10" cy="20" r="2.5" />
        <circle cx="90" cy="60" r="2.5" />
        <circle cx="160" cy="30" r="2.5" />
        <circle cx="240" cy="55" r="2.5" />
        <circle cx="300" cy="15" r="2.5" />
        <circle cx="20" cy="120" r="2.5" />
        <circle cx="80" cy="170" r="2.5" />
        <circle cx="150" cy="150" r="2.5" />
        <circle cx="220" cy="190" r="2.5" />
        <circle cx="290" cy="140" r="2.5" />
      </g>
      <circle cx="160" cy="105" r="34" fill="none" stroke="var(--fg)" stroke-width="1" />
      <text x="160" y="101" text-anchor="middle" font-size="13" font-weight="700" fill="var(--fg)">₿ UFMG</text>
      <text x="160" y="115" text-anchor="middle" font-size="6" letter-spacing="1" fill="var(--muted)">
        DECENTRALIZED NETWORK
      </text>
    </svg>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: center;
    margin-top: 2rem;
  }
  .hero-title {
    font-size: 2.4rem;
    font-weight: 700;
    text-transform: uppercase;
    margin: 0 0 1rem 0;
    line-height: 1.1;
  }
  .hero-about {
    margin: 0 0 1.5rem 0;
    max-width: 46ch;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
  }
  .hero-art {
    display: flex;
    justify-content: center;
  }
  .hero-art svg {
    width: 100%;
    max-width: 340px;
    height: auto;
  }
  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
</style>
