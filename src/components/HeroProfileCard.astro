---
import { withBase } from "../lib/url.js";

export interface Props {
  displayName: string;
  about: string;
  pubkey: string;
  projectsCount: number;
  eventsCount: number;
  logoUrl?: string | null;
}

const { displayName, about, pubkey, projectsCount, eventsCount, logoUrl } =
  Astro.props;

function shortPubkey(pk: string): string {
  return `${pk.slice(0, 7)}...${pk.slice(-9)}`;
}
---

<section class="hero panel--accent-left">
  <div class="hero-text">
    <h1 class="hero-title">{displayName}</h1>
    <p class="hero-about">{about}</p>
    <div class="hero-actions">
      <a class="btn btn--dark" href={withBase("/manifesto")}>
        Read manifesto
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>
  <div class="hero-art corner-accent">
    <img
      class="hero-logo"
      src={withBase("/svg/clube-bitcoin-logo.svg")}
      alt={`${displayName} logo`}
      width="220"
      height="220"
    />
  </div>
</section>

<section class="stat-bar">
  <div class="stat">
    <span class="mono-label">PubKey</span>
    <span class="stat-value stat-value--pubkey">{shortPubkey(pubkey)}</span>
  </div>
  <div class="stat">
    <span class="mono-label">Projects</span>
    <span class="stat-value stat-value--counter">{projectsCount}</span>
  </div>
  <div class="stat">
    <span class="mono-label">Events</span>
    <span class="stat-value stat-value--counter">{eventsCount}</span>
  </div>
  <div class="stat">
    <span class="mono-label">Established at</span>
    <span class="stat-value stat-value--muted">900,792</span>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2rem;
    align-items: center;
    margin-top: 2rem;
  }
  .hero-title {
    font-size: clamp(2.25rem, 6vw, var(--fs-display));
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    margin: 0 0 1rem 0;
    line-height: 1.1;
  }
  .hero-about {
    margin: 0 0 1.5rem 0;
    max-width: 46ch;
    color: var(--muted);
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
  }
  .hero-art {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }
  .hero-logo {
    width: 100%;
    max-width: 290px;
    height: auto;
  }

  .stat-bar {
    text-align: center;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--border-soft);
    border-bottom: 1px solid var(--border-soft);
    padding: 0.5rem 0.5rem;
    margin: 1rem 0 
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0 1.25rem;
    border-right: 1px solid var(--border-soft);
  }
  .stat:first-child {
    padding-left: 0;
  }
  .stat:last-child {
    border-right: none;
  }
  .stat-value {
    font-weight: 700;
    font-size: 0.85rem;
  }
  .stat-value--pubkey {
    word-break: break-all;
    color: var(--accent);
  }
  .stat-value--counter {
    font-size: var(--fs-headline-md);
    line-height: 1.1;
    color: var(--accent);
    font-weight: 700;
  }
  .stat-value--muted {
    color: var(--accent);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .stat-bar {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.85rem 0;
    }
    .stat {
      border-right: none;
      padding: 0;
    }
  }
</style>
