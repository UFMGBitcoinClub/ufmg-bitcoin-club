---
export interface Props {
  relays: string[];
}

const { relays } = Astro.props;
---

<div class="relay-list">
  <h2 class="section-title">Recent Activity</h2>
  <p>
    Live dispatch from our Nostr relays. Research updates, project milestones, and
    cypherpunk musings.
  </p>
  <p class="relay-list-label">RELAYS CONNECTED:</p>
  <ul>
    {relays.map((relay) => <li>&gt; {relay}</li>)}
  </ul>
</div>

<style>
  .relay-list-label {
    font-size: 0.75rem;
    color: var(--muted);
    margin: 1.5rem 0 0.5rem 0;
  }
  .relay-list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.85rem;
  }
  .relay-list li {
    color: var(--accent);
    margin-bottom: 0.25rem;
  }
</style>
