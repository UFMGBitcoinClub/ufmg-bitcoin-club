---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "Bitcoin research, events, and projects from Clube Bitcoin UFMG.",
  active,
} = Astro.props;
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · Clube Bitcoin UFMG</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <Header active={active} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
